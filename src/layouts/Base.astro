---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, findStubs } from '../data/site';
import { pages, type PageKey } from '../data/pages';
import { graph, organization, website, webPage, breadcrumbs } from '../data/schema';

interface Props {
  page: PageKey;
  title: string;
  description: string;
  /** Тип сторінки для schema.org: WebPage, FAQPage, ContactPage тощо. */
  pageType?: string;
  /** Додаткові вузли розмітки (наприклад, FAQPage). */
  schema?: object[];
  /** Чи є на сторінці форма консультації (куди веде кнопка в шапці). */
  formOnPage?: boolean;
}

const { page, title, description, pageType = 'WebPage', schema = [], formOnPage = true } = Astro.props;
const info = pages[page];
const canonical = new URL(info.path, site.url).href;

// Запобіжник перед запуском: зняти noindex, поки у файлі даних лишилися
// заглушки, не вийде — збірка впаде і перелічить, що ще не заповнено.
// ALLOW_STUBS=1 — лише для перевірки «відкритого» режиму на тестовій збірці.
if (!site.noindex && !process.env.ALLOW_STUBS) {
  const stubs = findStubs();
  if (stubs.length) {
    throw new Error(
      `noindex знято, але в src/data/site.ts лишилися заглушки:\n  ${stubs.join('\n  ')}`,
    );
  }
}

const jsonLd = graph(
  organization(),
  website(),
  webPage(info, title, description, pageType),
  ...(page === 'home' ? [] : [breadcrumbs(info)]),
  ...schema,
);
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1463e9" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти до змісту</a>
    <Header current={page} ctaHref={formOnPage ? '#konsultatsiia' : '/#konsultatsiia'} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Легка поява блоків під час прокрутки. Ховаємо лише те, що нижче екрана,
      // тому без JS і при «зменшенні руху» сторінка повністю видима.
      const blocks = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (blocks.length && !calm && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.remove('reveal-pending');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );

        for (const block of blocks) {
          if (block.getBoundingClientRect().top > window.innerHeight) {
            block.classList.add('reveal-pending');
            observer.observe(block);
          }
        }
      }
    </script>
  </body>
</html>
