---
import Logo from './Logo.astro';
import Stub from './Stub.astro';
import { site } from '../data/site';
import { pages, footerNav } from '../data/pages';

const { executor, contacts } = site;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo />
        <p class="footer__disclaimer">
          Незалежний приватний сервіс. Не є державним органом, представником Міжнародного реєстру збитків,
          Ради Європи чи Дії. Подання заяви до Реєстру безоплатне — оплачуються лише наші послуги супроводу.
          Внесення заяви до Реєстру не гарантує виплату компенсації.
        </p>
      </div>

      <nav class="footer__nav" aria-label="Меню в підвалі">
        {
          footerNav.map((group) => (
            <div>
              <p class="footer__title">{group.title}</p>
              <ul>
                {group.items.map((key) => (
                  <li>
                    <a href={pages[key].path}>{pages[key].label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="footer__bottom">
      <p class="footer__legal">
        <Stub value={executor.legalName} />
        <Stub value={executor.code} />
        <Stub value={executor.address} />
      </p>
      <p class="footer__legal">
        <Stub value={contacts.phone} />
        <Stub value={contacts.email} />
        <Stub value={contacts.telegram} />
      </p>
      <p class="footer__copy">© {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 48px 32px;
    border-block-start: 1px solid var(--line);
    background: var(--white);
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 32px clamp(32px, 6vw, 88px);
    align-items: start;
  }

  .footer__disclaimer {
    margin-block-start: 20px;
    max-inline-size: 48ch;
  }

  .footer__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 24px;
  }

  .footer__title {
    margin-block-end: 12px;
    color: var(--navy);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer__nav ul {
    display: grid;
    gap: 10px;
  }

  .footer__nav a {
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .footer__nav a:hover {
    color: var(--blue);
  }

  .footer__bottom {
    display: grid;
    gap: 10px;
    margin-block-start: 36px;
    padding-block-start: 24px;
    border-block-start: 1px solid var(--line);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
  }

  @media (max-width: 1023px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 559px) {
    .footer__nav {
      grid-template-columns: 1fr;
    }

    .footer__nav a {
      font-size: 16px;
    }
  }
</style>
