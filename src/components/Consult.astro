---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  /** Без верхнього відступу — коли блок іде одразу за білою секцією (головна). */
  flush?: boolean;
}

const { flush = false } = Astro.props;
---

<section
  class:list={['section', { 'consult-section--flush': flush }]}
  id="konsultatsiia"
  aria-labelledby="konsultatsiia-title"
>
  <div class="container">
    <div class="consult" data-reveal>
      <div class="consult__text">
        <h2 id="konsultatsiia-title">Почнімо з <span class="accent">вашої ситуації</span></h2>
        <p class="consult__lead">
          Перша консультація безкоштовна. Пояснимо, які документи потрібні та що робити далі.
        </p>
      </div>

      <form class="form" data-consult-form data-endpoint={site.form.endpoint} novalidate>
        <label class="field">
          <span class="visually-hidden">Як до вас звертатися?</span>
          <Icon name="user" size={22} />
          <input
            type="text"
            name="name"
            placeholder="Як до вас звертатися?"
            autocomplete="name"
            maxlength="80"
            required
          />
        </label>
        <label class="field">
          <span class="visually-hidden">Ваш контакт для зв’язку: телефон, Telegram або e-mail</span>
          <Icon name="phone" size={22} />
          <input
            type="text"
            name="contact"
            placeholder="Ваш контакт для зв’язку"
            maxlength="120"
            required
          />
        </label>

        <button class="btn form__submit" type="submit">
          Отримати консультацію
          <Icon name="arrow" size={20} />
        </button>

        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>
            Погоджуюся на обробку даних для відповіді на звернення згідно з{' '}
            <a href={site.links.privacy}>політикою конфіденційності</a>.
          </span>
        </label>

        <p class="form__status" data-form-status role="status" aria-live="polite" hidden></p>

        <p class="form__note">
          Перша консультація безкоштовна. Подальший супровід — платний, за умовами, погодженими до початку роботи. Не надсилайте документи,
          паролі, ключі електронного підпису чи банківські коди — ми їх ніколи не просимо.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  // ───────────────────────────────────────────────────────────────────────────
  // TODO(етап 2): підключити реальний обробник заявок.
  //   Зараз форма НІЧОГО нікуди не надсилає і нічого не зберігає — це заглушка.
  //   GitHub Pages форми не обробляє, тому потрібен зовнішній обробник.
  //   План із розбору: Cloudflare Worker → Telegram клієнта + e-mail.
  //   1) адресу обробника записати в site.form.endpoint (src/data/site.ts);
  //   2) у sendLead() нижче прибрати гілку demo — fetch уже написаний;
  //   3) файли через форму не приймати, контакти заявників у репозиторій не писати.
  // ───────────────────────────────────────────────────────────────────────────
  type Lead = { name: string; contact: string; consent: boolean };
  type Result = { ok: boolean; demo?: boolean };

  async function sendLead(endpoint: string, lead: Lead): Promise<Result> {
    if (!endpoint) return { ok: false, demo: true };

    const response = await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(lead),
    });
    return { ok: response.ok };
  }

  const form = document.querySelector<HTMLFormElement>('[data-consult-form]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');

  if (form && status) {
    const show = (kind: 'error' | 'info' | 'ok', text: string) => {
      status.hidden = false;
      status.dataset.kind = kind;
      status.textContent = text;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const lead: Lead = {
        name: String(data.get('name') ?? '').trim(),
        contact: String(data.get('contact') ?? '').trim(),
        consent: data.get('consent') === 'on',
      };

      if (!lead.name || !lead.contact) {
        show('error', 'Вкажіть, будь ласка, як до вас звертатися і контакт для зв’язку.');
        return;
      }
      if (!lead.consent) {
        show('error', 'Щоб ми могли відповісти, потрібна ваша згода на обробку даних.');
        return;
      }

      try {
        const result = await sendLead(form.dataset.endpoint ?? '', lead);
        if (result.demo) {
          show('info', 'Демо-режим: форму ще не підключено. Заявку нікуди не надіслано, дані не збережено.');
        } else if (result.ok) {
          form.reset();
          show('ok', 'Дякуємо! Ми отримали звернення і зв’яжемося з вами.');
        } else {
          show('error', 'Не вдалося надіслати звернення. Спробуйте, будь ласка, ще раз.');
        }
      } catch {
        show('error', 'Не вдалося надіслати звернення. Перевірте з’єднання і спробуйте ще раз.');
      }
    });
  }
</script>

<style>
  .consult-section--flush {
    padding-block-start: 0;
  }

  .consult {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
    padding: clamp(24px, 5vw, 64px);
    border-radius: 24px;
    overflow: hidden;
    background:
      radial-gradient(60% 120% at 62% 50%, rgb(255 255 255 / 70%) 0%, transparent 62%),
      linear-gradient(120deg, var(--sky-100) 0%, #dbe9ff 100%);
  }

  .consult__lead {
    margin-block-start: 20px;
    max-inline-size: 26ch;
    color: var(--ink);
    font-size: clamp(18px, 1.9vw, 21px);
  }

  .form {
    display: grid;
    gap: 14px;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-inline: 18px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--muted);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .field:focus-within {
    border-color: var(--blue);
    box-shadow: 0 0 0 4px rgb(20 99 233 / 14%);
  }

  .field :global(svg) {
    flex: none;
  }

  .field input {
    flex: 1;
    min-inline-size: 0;
    block-size: 56px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--navy);
    font: inherit;
    font-size: 17px;
  }

  .field input::placeholder {
    color: #71809b;
    opacity: 1;
  }

  .form__submit {
    inline-size: 100%;
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 15px;
    line-height: 1.45;
    cursor: pointer;
  }

  .consent input {
    flex: none;
    inline-size: 22px;
    block-size: 22px;
    margin: 0;
    accent-color: var(--blue);
    cursor: pointer;
  }

  .form__status {
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.45;
  }

  .form__status[data-kind='error'] {
    background: #fde8e8;
    color: #8f1d1d;
  }

  .form__status[data-kind='info'] {
    background: var(--yellow-soft);
    color: #3d2f05;
  }

  .form__status[data-kind='ok'] {
    background: #e3f6ea;
    color: #14532d;
  }

  .form__note {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }

  @media (max-width: 1023px) {
    .consult {
      grid-template-columns: 1fr;
    }

    .consult__lead {
      max-inline-size: none;
    }
  }

  @media (max-width: 559px) {
    .consult {
      margin-inline: calc(var(--gutter) * -0.5);
      border-radius: 20px;
    }
  }
</style>
