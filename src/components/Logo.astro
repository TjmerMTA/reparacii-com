---
// Знак намальовано заново у власному SVG за мотивом із макета (документ у долонях).
// TODO: замінити на оригінальний файл логотипа клієнта, щойно він його надішле.
import { site } from '../data/site';

interface Props {
  href?: string;
}

const { href = '/' } = Astro.props;
---

<a class="logo" href={href} aria-label={`${site.name} — ${site.tagline}, на головну`}>
  <svg class="logo__mark" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" focusable="false">
    <path d="M4 19c-.5 12 6.500 20.500 19 23.500-2.800-3.600-4-7-4-10.500C12.500 30 8.500 25.500 7.500 19H4Z" fill="#1463e9"></path>
    <path d="M44 19c.5 12-6.500 20.500-19 23.500 2.800-3.600 4-7 4-10.500C35.500 30 39.500 25.500 40.500 19H44Z" fill="#f7b500"></path>
    <rect x="14.500" y="4.500" width="19" height="24" rx="3.500" fill="#fff" stroke="#1463e9" stroke-width="2.600"></rect>
    <path d="M19.500 11.500h9M19.500 16.500h9M19.500 21.500h5.500" stroke="#1463e9" stroke-width="2.400" stroke-linecap="round"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name">
      <span>Центр</span>
      <span>репараційної</span>
      <span class="logo__gold">допомоги</span>
    </span>
    <span class="logo__tag">{site.tagline}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--blue);
    text-decoration: none;
  }

  .logo__mark {
    flex: none;
  }

  .logo__text {
    display: grid;
    gap: 3px;
  }

  .logo__name {
    display: grid;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .logo__gold {
    color: #eda900;
  }

  .logo__tag {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
</style>
