---
// Перелік першоджерел, за якими звірено сторінку.
import Icon from './Icon.astro';
import { formatDate, VERIFIED } from '../data/pages';
import type { Source } from '../data/sources';

interface Props {
  items: Source[];
}

const { items } = Astro.props;
---

<section class="sources" aria-labelledby="sources-title">
  <h2 id="sources-title">Джерела</h2>
  <p>
    Станом на {formatDate(VERIFIED)} сторінку звірено з офіційними матеріалами Реєстру збитків і порталу Дія.
    Правила можуть змінюватися — перед поданням перевіряйте актуальну інформацію в першоджерелах.
  </p>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href} target="_blank" rel="noopener noreferrer">
            {item.label}
            <Icon name="external" size={16} />
            <span class="visually-hidden">(відкриється в новій вкладці)</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .sources {
    margin-block-start: 56px;
    padding: 24px 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sky-50);
    font-size: 15px;
    line-height: 1.5;
  }

  .sources h2 {
    margin: 0;
    font-size: 20px;
  }

  .sources p {
    margin-block: 10px 14px;
    color: var(--muted);
  }

  .sources ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .sources li {
    padding: 0;
  }

  .sources li::before {
    content: none;
  }

  .sources a {
    font-weight: 600;
  }

  .sources a :global(svg) {
    margin-inline-start: 4px;
    vertical-align: -2px;
  }
</style>
