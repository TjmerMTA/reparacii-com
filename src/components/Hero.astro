---
import Icon from './Icon.astro';
import HeroArt from './HeroArt.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow"><span>Документи</span><span>Докази</span><span>Супровід</span></p>
      <h1 id="hero-title">
        Допоможемо підготувати заяву <span class="accent hero__accent">на репарації</span>
      </h1>
      <p class="hero__lead">
        Залишили свій дім або втратили доступ до нерухомості? Допоможемо розібратися з документами
        та підготувати заяву до Міжнародного Реєстру збитків для України. Подаєте її ви самі —
        у власному кабінеті Дії.
      </p>
      <a class="btn hero__cta" href="#konsultatsiia">
        Отримати першу консультацію безкоштовно
        <Icon name="arrow" size={20} />
      </a>
      <p class="hero__online">
        <Icon name="wifi" size={22} />
        Онлайн, де б ви не перебували
      </p>
    </div>
  </div>

  <div class="hero__media">
    <div class="hero__art"><HeroArt /></div>
    <p class="hero__stub-note">Ілюстрація-заглушка · замінимо на власне фото</p>
    <div class="hero__card">
      <span class="hero__card-icon"><Icon name="doc" size={24} /></span>
      <p>Ви не самі. Допоможемо з&nbsp;наступним кроком.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--white) 0%, var(--sky-50) 100%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(40px, 5vw, 64px) clamp(56px, 7vw, 96px);
    pointer-events: none;
  }

  .hero__text {
    max-inline-size: 620px;
    pointer-events: auto;
  }

  .hero__accent {
    display: block;
  }

  .hero__lead {
    margin-block-start: 24px;
    max-inline-size: 540px;
    color: var(--muted);
  }

  .hero__cta {
    margin-block-start: 32px;
  }

  .hero__online {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-block-start: 24px;
    font-size: 15px;
    color: var(--muted);
  }

  .hero__online :global(svg) {
    color: var(--navy);
  }

  .hero__media {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: 58%;
  }

  .hero__art {
    block-size: 100%;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 36%);
    mask-image: linear-gradient(to right, transparent 0, #000 36%);
  }

  .hero__stub-note {
    position: absolute;
    inset-block-start: 20px;
    inset-inline-end: max(var(--gutter), calc((100vw - var(--container)) / 2));
    padding: 6px 12px;
    border: 1.5px dashed #d9a400;
    border-radius: 999px;
    background: var(--yellow-soft);
    color: var(--yellow-ink);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
  }

  .hero__card {
    position: absolute;
    inset-block-end: clamp(32px, 6vw, 64px);
    inset-inline-end: max(var(--gutter), calc((100vw - var(--container)) / 2));
    display: flex;
    align-items: center;
    gap: 14px;
    max-inline-size: 300px;
    padding: 18px 22px;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: 0 16px 40px rgb(13 27 62 / 14%);
    color: var(--navy);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
  }

  .hero__card-icon {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 48px;
    block-size: 48px;
    border-radius: 50%;
    background: var(--sky-100);
    color: var(--blue);
  }

  @media (max-width: 1023px) {
    .hero__inner {
      padding-block-end: 32px;
    }

    .hero__text {
      max-inline-size: none;
    }

    .hero__cta {
      inline-size: 100%;
    }

    .hero__media {
      position: relative;
      inline-size: auto;
      block-size: clamp(260px, 60vw, 420px);
      margin: 0 var(--gutter) 40px;
      border-radius: 20px;
      overflow: hidden;
    }

    .hero__art {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .hero__stub-note {
      inset-block-start: 12px;
      inset-inline: 12px auto;
    }

    .hero__card {
      inset-block-end: 12px;
      inset-inline: 12px;
      max-inline-size: none;
      padding: 12px 16px;
      font-size: 15px;
    }

    .hero__card-icon {
      inline-size: 40px;
      block-size: 40px;
    }
  }
</style>
