---
// Акордеон на <details>: працює без JS, відповіді доступні пошуку по сторінці.
import Icon from './Icon.astro';
import type { FaqGroup } from '../data/faq';

interface Props {
  groups: FaqGroup[];
}

const { groups } = Astro.props;
---

{
  groups.map((group, groupIndex) => (
    <section class="faq">
      <h2>{group.title}</h2>
      <div class="faq__list">
        {group.items.map((item, index) => (
          <details class="faq__item" open={groupIndex === 0 && index === 0}>
            <summary>
              <h3>{item.q}</h3>
              <span class="faq__mark" aria-hidden="true" />
            </summary>
            <div class="faq__answer">
              {item.a.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {item.more && (
                <p>
                  <a class="arrow-link" href={item.more.href}>
                    {item.more.label}
                    <Icon name="arrow" size={18} />
                  </a>
                </p>
              )}
            </div>
          </details>
        ))}
      </div>
    </section>
  ))
}

<style>
  .faq + .faq {
    margin-block-start: 48px;
  }

  .faq h2 {
    margin: 0 0 20px;
  }

  .faq__list {
    display: grid;
    gap: 12px;
  }

  .faq__item {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
    box-shadow: var(--shadow);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .faq__item:hover,
  .faq__item[open] {
    border-color: var(--sky-200);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
  }

  .faq__mark {
    position: relative;
    flex: none;
    inline-size: 28px;
    block-size: 28px;
    border-radius: 50%;
    background: var(--sky-100);
  }

  .faq__mark::before,
  .faq__mark::after {
    content: '';
    position: absolute;
    inset-block-start: 13px;
    inset-inline-start: 8px;
    inline-size: 12px;
    block-size: 2px;
    border-radius: 2px;
    background: var(--blue);
    transition: transform 0.3s ease;
  }

  .faq__mark::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__mark::after {
    transform: rotate(0deg);
  }

  .faq__answer {
    display: grid;
    gap: 12px;
    padding: 0 22px 22px;
    font-size: 17px;
  }

  .faq__answer p {
    margin: 0;
  }
</style>
