  <rect x="394" y="104" width="12" height="46" rx="3" fill="#9db8e4"></rect>
  <rect x="408" y="118" width="12" height="32" rx="3" fill="#f7b500"></rect>

  <!-- стіл -->
  <rect y="452" width="800" height="148" fill="url(#art-desk)"></rect>
  <rect y="452" width="800" height="8" fill="#b3c8ea"></rect>

  <!-- ноутбук -->
  <rect x="300" y="208" width="372" height="244" rx="16" fill="#16305f"></rect>
  <rect x="314" y="222" width="344" height="210" rx="6" fill="#fff"></rect>
  <rect x="314" y="222" width="72" height="210" fill="#f1f6fe"></rect>
  <rect x="328" y="242" width="28" height="28" rx="8" fill="#1463e9"></rect>
  <path d="M328 292h44M328 310h36M328 328h44M328 346h30" stroke="#c5d6f0" stroke-width="6" stroke-linecap="round"></path>
  <path d="M408 250h120" stroke="#0d1b3e" stroke-width="9" stroke-linecap="round"></path>
  <rect x="408" y="274" width="226" height="28" rx="6" fill="#f1f6fe" stroke="#d6e4f8" stroke-width="2"></rect>
  <rect x="408" y="312" width="226" height="28" rx="6" fill="#f1f6fe" stroke="#d6e4f8" stroke-width="2"></rect>
