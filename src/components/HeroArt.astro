    <linearGradient id="art-desk" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#cddcf3"></stop>
      <stop offset="1" stop-color="#bccfee"></stop>
    </linearGradient>
  </defs>

  <rect width="800" height="600" fill="url(#art-wall)"></rect>

  <!-- вікно -->
  <rect x="500" y="36" width="250" height="250" rx="16" fill="#f8fbff"></rect>
  <path d="M625 36v250M500 161h250" stroke="#d6e4f8" stroke-width="6"></path>
  <circle cx="690" cy="96" r="26" fill="#ffe9a6"></circle>

